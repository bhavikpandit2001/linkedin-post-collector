{
  "manifest_version": 3,
  "name": "LinkedIn Post Collector",
  "version": "1.0.0",
  "description": "Single-click extraction of visible LinkedIn feed posts into a local Side Panel table with Excel CSV export.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open LinkedIn Post Collector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "js": [
        "src/content/extractor.js",
        "src/content/observer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
